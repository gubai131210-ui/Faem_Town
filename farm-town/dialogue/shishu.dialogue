~ work
if Residents.owes_thanks("shishu")
	石叔: 上回的{{Residents.gift_name("shishu")}}，吃了。不错。
	do Residents.thanked("shishu")
elif Residents.away("shishu") >= 4
	石叔: 有日子没来了。家伙还趁手？
elif Residents.weather_is("rain") or Residents.weather_is("storm")
	% 石叔: 雨天炉子不好烧。活照做。
	% 石叔: 站里头点，别淋着。
elif Residents.season_is("summer")
	% 石叔: 热。离炉子远点。
	% 石叔: 要打什么。
elif Residents.knows("shishu", 50)
	% 石叔: 来了。
	% 石叔: 是你啊。炉子正热着。 [#happy]
	% 石叔: 今天打什么？
else
	% 石叔: 要打什么。
	% 石叔: 嗯。
	% 石叔: 炉子热着。
- 升级工具
	do EventBus.request_shop("smith")
- 随便聊聊
	if Residents.topic("shishu", 6) == 0
		石叔: 师父教过我七道工序。
		石叔: 我现在只做六道。最后一道……怎么也想不起来。 [#sad]
	elif Residents.topic("shishu", 6) == 1
		石叔: 铁不骗人。火候到了就是到了，没到就是没到。
		石叔: 比人好打交道。
	elif Residents.topic("shishu", 6) == 2
		石叔: 你那把锄头是老东西。料子不差，是以前的人打的。
		石叔: ……看着眼熟。说不上来。
	elif Residents.topic("shishu", 6) == 3
		石叔: 阿禾话多。
		石叔: 人不坏。
	elif Residents.topic("shishu", 6) == 4
		石叔: 你种地，我打铁。都是一下一下来的活。
		石叔: 急不得。
	else
		if Residents.knows("shishu", 60)
			石叔: 有时候锤子举到一半，我会忘了下一锤落哪儿。
			石叔: 就那么举着。等它自己想起来。
		else
			石叔: 没什么可聊的。……不是嫌你。我就这样。
- 没事
	石叔: 嗯。
=> END

