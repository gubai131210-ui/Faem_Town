~ again
if Residents.lamp_news("laoqin", "well")
	=> well_lamp_news
if Residents.lamp_lit("pasture") and not Residents.lamp_lit("well") and not Residents.has_flag("got_well_key") and Residents.knows("laoqin", 40)
	=> well_key
if Residents.nth("laoqin") == 2
	% 老秦: 又是你。
	% 老秦: 还没完了？
else
	% 老秦: 没空！
	% 老秦: 走走走。
